{
  "name": "saade/facehash",
  "description": "Deterministic avatar faces from any string. Lightweight, pure SVG output. Laravel integration.",
  "keywords": [
    "facehash",
    "avatar",
    "laravel",
    "deterministic",
    "identicon",
    "svg"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Saade\\Facehash\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Saade\\Facehash\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Saade\\Facehash\\FacehashServiceProvider"
      ],
      "aliases": {
        "Facehash": "Saade\\Facehash\\Facades\\Facehash"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
